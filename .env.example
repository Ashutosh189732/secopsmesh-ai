# Copy this file to .env and fill in real values.

# OpenRouter API key — used by the Orchestrator / Root Cause / Risk / Remediation
# agents starting Day 3. All LLM calls go through OpenRouter's OpenAI-compatible
# API (not Anthropic directly). Not required yet for Day 1 (signal intake only).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Which model OpenRouter should route to. Verify against
# https://openrouter.ai/anthropic if you change this — vendor slugs there can
# differ from Anthropic's own model IDs.
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Optional shared secret for the /api endpoints, sent by clients as the
# X-API-Key header. Leave unset for local dev / the demo (endpoints are open);
# set it in the deployed environment to require the header on /api/signals and
# /api/incidents. /health stays open regardless. POC-grade gate, not per-user auth.
# API_KEY=change-me-in-deploy

# Database connection string.
# Local dev default: SQLite file in the project root — no server to install.
# At deploy time (Railway), set this to the provisioned Postgres URL instead,
# e.g. postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./secopsmesh.db
