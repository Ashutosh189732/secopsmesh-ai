# SecOpsMeshAI Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# DATABASE
# ============================================================================
# Local development: SQLite (no setup required)
DATABASE_URL=sqlite:///./secopsmesh.db

# Production: PostgreSQL (Railway auto-provisions this)
# DATABASE_URL=postgresql://user:password@host:5432/secopsmesh_prod


# ============================================================================
# LLM ACCESS (Required for Agents — Day 3+)
# ============================================================================
# Choose your LLM provider: "openrouter" (default) or "azure"
LLM_PROVIDER=openrouter

# ----- OpenRouter Configuration (default) -----
# Get your OpenRouter API key at: https://openrouter.ai/keys
# OpenRouter gives you access to all Claude models via one OpenAI-compatible API
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model selection (default: Claude Sonnet 5)
# Other options: anthropic/claude-opus-5, anthropic/claude-haiku-4.5
# See pricing: https://openrouter.ai/anthropic
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# OpenRouter base URL (do NOT change unless using a different provider)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ----- Azure OpenAI Configuration (alternative) -----
# Use these settings when LLM_PROVIDER=azure
# Your Azure OpenAI resource endpoint (e.g., https://your-resource.openai.azure.com/)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Your deployed model name (e.g., gpt-4o, gpt-4-turbo, gpt-35-turbo)
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-deployment

# API version (recommended: 2024-02-15-preview for latest features)
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Authentication Option 1: API Key (simpler, good for development)
# AZURE_OPENAI_API_KEY=your-azure-api-key-here

# Authentication Option 2: Azure AD (recommended for production)
# Leave AZURE_OPENAI_API_KEY empty to use DefaultAzureCredential
# Requires: pip install azure-identity
# Uses environment variables: AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID
# Or managed identity when deployed to Azure (App Service, Container Apps, etc.)


# ============================================================================
# QUEUE / CACHE (Optional for local dev)
# ============================================================================
# Local development: in-process queue (default, no setup)
# Production: Redis for background worker coordination
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://user:password@redis-host:6379/0  # Railway auto-provisions


# ============================================================================
# APPLICATION SETTINGS (Optional)
# ============================================================================
# Environment mode (development | production)
ENVIRONMENT=development

# Log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# CORS origins (comma-separated, for frontend access)
# Local dev default:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production: add your Vercel domain
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000


# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================
# Enable on-demand FP gate explanation (LLM call for "Explain with AI" button)
ENABLE_FP_EXPLANATION=true

# Enable evidence guard triggers (hard timeout/iteration caps)
ENABLE_EVIDENCE_GUARDS=true

# Max evidence items to collect per incident (default: 3)
MAX_EVIDENCE_ITEMS=3

# Orchestrator timeout in seconds (default: 90)
ORCHESTRATOR_TIMEOUT_SECONDS=90


# ============================================================================
# CONNECTOR SELECTION MODE
# ============================================================================
# Choose how the orchestrator selects which evidence connectors to query:
#
# false (default): Hard-coded priority order per signal type
#   - PublicStorageBucket → azure_monitor, github_commits, iam_logs, kubernetes
#   - LargeDataUpload → azure_monitor, kubernetes, iam_logs, github_commits
#   - UnauthorizedAPICall → iam_logs, azure_monitor, github_commits, kubernetes
#   - Predictable, fast, prevents irrelevant sources
#
# true: Fully agentic - LLM chooses from all available connectors
#   - All 4 connectors available for every incident type
#   - LLM decides which are most relevant based on incident context
#   - More autonomous, adapts to novel patterns
#
USE_AGENTIC_CONNECTOR_SELECTION=false


# ============================================================================
# DEMO / TESTING (Optional)
# ============================================================================
# Auto-run demo scenario on startup (useful for hackathon live demos)
# AUTO_RUN_DEMO_SCENARIO=03_investigating_gdpr

# Seed database with sample incidents on startup (true | false)
# SEED_DB_ON_STARTUP=false


# ============================================================================
# NOTES FOR HACKATHON JUDGES
# ============================================================================
# 1. Only OPENROUTER_API_KEY is required to run the full demo
#    - Get a free key at https://openrouter.ai (no credit card for trials)
#    - $5 credit is enough to run all demo scenarios 10+ times
#
# 2. DATABASE_URL defaults to SQLite — no Postgres setup needed locally
#
# 3. The frontend automatically connects to http://127.0.0.1:8000
#    - Set NEXT_PUBLIC_API_URL in frontend/.env.local to override
#
# 4. To test without LLM access (Day 1-2 features only):
#    - Leave OPENROUTER_API_KEY empty
#    - POST signals still works, correlation + FP gate still work
#    - Orchestrator/agents will fail gracefully with "API key not set" error
#
# 5. Production deployment (Railway + Vercel):
#    - Railway auto-sets DATABASE_URL and REDIS_URL
#    - Only need to add OPENROUTER_API_KEY as a secret
#    - Vercel frontend needs NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
